<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF4F4">

    <ImageView
        android:id="@+id/backgroundImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/sky_blue"
        android:contentDescription="background" />

    <!-- TITLE -->
    <TextView
        android:id="@+id/performanceTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="16dp"
        android:background="#B71C1C"
        android:text="Performance"
        android:textColor="@android:color/white"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- SCROLL AREA -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/performanceTitle"
        android:layout_above="@id/bottomNavigationView"
        android:padding="16dp">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- QUIZ 1 -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:padding="16dp"
                android:background="@drawable/topic_item_bg"
                android:layout_marginBottom="16dp"
                android:elevation="6dp">

                <TextView
                    android:id="@+id/quiz1Score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Loading..."
                    android:textColor="#B71C1C"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@id/progressCircle1"
                    android:layout_marginEnd="16dp" />

                <com.example.project1.ProgressCircleView
                    android:id="@+id/progressCircle1"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true" />

            </RelativeLayout>

            <!-- QUIZ 2 -->
