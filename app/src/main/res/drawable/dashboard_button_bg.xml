<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- White background -->
    <solid android:color="#FFFFFF" />

    <!-- Blue outline -->
    <stroke
        android:width="2dp"
        android:color="#2196F3" />

    <!-- Rounded corners -->
    <corners android:radius="12dp" />

    <!-- Inner padding -->
    <padding
        android:left="12dp"
        android:top="12dp"
        android:right="12dp"
        android:bottom="12dp" />
</shape>
